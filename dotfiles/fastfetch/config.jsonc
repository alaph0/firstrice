
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "path/to/your/picture",
    "width": 30,
    "height": 15,
    "padding": {
      "right": 3
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "break",
    "colors"
  ]
}

